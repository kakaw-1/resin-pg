RESIN_ADMIN_TOKEN=change-me-admin-token
# Set RESIN_PROXY_TOKEN= to disable proxy authentication.
RESIN_PROXY_TOKEN=change-me-proxy-token
RESIN_PORT=2260

# --- Persistence backend -------------------------------------------------
# Default: local SQLite (state.db under RESIN_STATE_DIR, cache.db under
# RESIN_CACHE_DIR). Leave RESIN_DB_DRIVER unset for that.
#
# In postgres mode RESIN_STATE_DIR is unused; RESIN_CACHE_DIR still holds the
# downloaded GeoIP .mmdb assets.
#
# PostgreSQL keeps the same data in two schemas of one database. Both schemas
# are created and migrated automatically on first start, and they must live in
# the same database (startup orphan cleanup joins across them).
# Request logs and metrics always stay on local files and are not affected.
#
# RESIN_DB_DRIVER=postgres
# RESIN_DB_DSN=postgres://resin:change-me@127.0.0.1:5432/resin?sslmode=disable
# RESIN_DB_STATE_SCHEMA=resin_state
# RESIN_DB_CACHE_SCHEMA=resin_cache
# RESIN_DB_MAX_OPEN_CONNS=8
# RESIN_DB_MAX_IDLE_CONNS=4
# RESIN_DB_CONN_MAX_LIFETIME=30m
# RESIN_DB_CONNECT_TIMEOUT=10s
